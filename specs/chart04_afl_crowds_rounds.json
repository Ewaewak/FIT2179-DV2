{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot plot of every MCG match crowd in the 2024 AFL season, highlighting finals. Source: AFL Tables.",
  "width": "container",
  "height": 240,
  "data": {
    "url": "../data_afl_crowds_2024.json",
    "format": {"type": "json"}
  },
  "transform": [{"filter": "datum.venue == 'M.C.G.'"}],
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 80, "opacity": 0.7},
      "encoding": {
        "x": {
          "field": "crowd",
          "type": "quantitative",
          "title": "Attendance",
          "axis": {"format": ","},
          "scale": {"domain": [40000, 105000]}
        },
        "y": {"field": "round", "type": "nominal", "title": "Round"},
        "color": {
          "field": "finals",
          "type": "nominal",
          "scale": {
            "domain": [false, true],
            "range": ["#4caf50", "#f39c12"]
          },
          "legend": {
            "title": "Type",
            "labelExpr": "datum.value ? 'Finals' : 'H&A'"
          }
        },
        "tooltip": [
          {"field": "home", "title": "Home"},
          {"field": "away", "title": "Away"},
          {"field": "date", "title": "Date"},
          {"field": "crowd", "title": "Crowd", "format": ","},
          {"field": "finals", "title": "Finals"}
        ]
      }
    }
  ]
}
