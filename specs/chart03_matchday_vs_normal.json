{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grouped bar chart comparing estimated match-day vs normal Saturday boardings per key station.",
  "width": "container",
  "height": 260,
  "data": {
    "url": "../data_match_boardings.json",
    "format": {"type": "json"}
  },
  "mark": {
    "type": "bar",
    "cornerRadiusTopRight": 2,
    "cornerRadiusBottomRight": 2
  },
  "encoding": {
    "y": {"field": "station", "type": "nominal", "sort": ["-x"], "title": null},
    "x": {
      "field": "boardings",
      "type": "quantitative",
      "title": "Estimated boardings",
      "axis": {"format": ","}
    },
    "color": {
      "field": "type",
      "type": "nominal",
      "scale": {
        "domain": ["Match Day Saturday", "Normal Saturday"],
        "range": ["#2ecc71", "#2a2e45"]
      },
      "legend": {"orient": "top", "title": null}
    },
    "yOffset": {"field": "type", "type": "nominal"},
    "tooltip": [
      {"field": "station"},
      {"field": "type", "title": "Day type"},
      {"field": "boardings", "title": "Est. boardings", "format": ","}
    ]
  }
}
