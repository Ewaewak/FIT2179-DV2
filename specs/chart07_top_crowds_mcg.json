{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 10 highest-attended AFL matches at the MCG in 2024. Click a bar to highlight it. Source: AFL Tables.",
  "width": "container",
  "height": 260,
  "data": {
    "url": "../data_afl_crowds_2024.json",
    "format": {"type": "json"}
  },
  "transform": [
    {"filter": "datum.venue == 'M.C.G.'"},
    {"window": [{"op": "rank", "as": "rank"}], "sort": [{"field": "crowd", "order": "descending"}]},
    {"filter": "datum.rank <= 10"}
  ],
  "params": [{"name": "sel", "select": {"type": "point", "fields": ["home"]}}],
  "mark": {"type": "bar", "cornerRadiusTopRight": 3},
  "encoding": {
    "y": {"field": "crowd", "type": "quantitative", "title": "Attendance", "axis": {"format": ","}},
    "x": {"field": "home", "type": "nominal", "sort": "-y", "title": "Home team", "axis": {"labelAngle": -30}},
    "color": {
      "condition": {"param": "sel", "value": "#2ecc71"},
      "value": "#333d5e"
    },
    "opacity": {
      "condition": {"param": "sel", "value": 1},
      "value": 0.5
    },
    "tooltip": [
      {"field": "home"}, {"field": "away"}, {"field": "date"},
      {"field": "crowd", "format": ","}, {"field": "finals"}
    ]
  }
}
