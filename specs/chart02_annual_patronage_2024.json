{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual boardings at key precinct stations in 2024. Source: Transport Victoria Open Data.",
  "width": "container",
  "height": 140,
  "data": {
    "url": "../data_station_patronage.json",
    "format": {"type": "json"}
  },
  "transform": [{"filter": "datum.year == 2024"}],
  "mark": {
    "type": "bar",
    "cornerRadiusTopRight": 3,
    "cornerRadiusBottomRight": 3
  },
  "encoding": {
    "y": {"field": "station", "type": "nominal", "sort": "-x", "title": null},
    "x": {"field": "patronage", "type": "quantitative", "title": "Annual boardings", "axis": {"format": "~s"}},
    "color": {"value": "#f39c12"},
    "tooltip": [
      {"field": "station"},
      {"field": "patronage", "title": "Boardings (2024)", "format": ","}
    ]
  }
}
