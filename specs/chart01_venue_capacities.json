{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Venue capacities for the three Melbourne sports precinct stadiums",
  "width": "container",
  "height": 140,
  "data": {
    "values": [
      {"venue": "M.C.G.", "capacity": 100024},
      {"venue": "Marvel Stadium", "capacity": 56347},
      {"venue": "AAMI Park", "capacity": 30050}
    ]
  },
  "mark": {
    "type": "bar",
    "cornerRadiusTopRight": 3,
    "cornerRadiusBottomRight": 3
  },
  "encoding": {
    "y": {
      "field": "venue",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "capacity",
      "type": "quantitative",
      "title": "Capacity",
      "axis": {"format": ","}
    },
    "color": {
      "field": "venue",
      "type": "nominal",
      "scale": {
        "domain": ["M.C.G.", "Marvel Stadium", "AAMI Park"],
        "range": ["#4caf50", "#1565c0", "#f57c00"]
      },
      "legend": null
    },
    "tooltip": [
      {"field": "venue", "title": "Venue"},
      {"field": "capacity", "title": "Capacity", "format": ","}
    ]
  }
}
