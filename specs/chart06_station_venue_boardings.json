{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal bar chart of match-day boardings per station, coloured by the venue it primarily serves.",
  "width": "container",
  "height": 180,
  "data": {
    "values": [
      {"station": "Jolimont", "boardings": 28500, "venue": "MCG"},
      {"station": "Richmond", "boardings": 21000, "venue": "MCG / AAMI Park"},
      {"station": "North Melbourne", "boardings": 18500, "venue": "Marvel Stadium"},
      {"station": "Flinders Street", "boardings": 55000, "venue": "All venues"},
      {"station": "Spencer Street", "boardings": 14200, "venue": "Marvel Stadium"}
    ]
  },
  "mark": {"type": "bar", "cornerRadiusTopRight": 3, "cornerRadiusBottomRight": 3},
  "encoding": {
    "y": {"field": "station", "type": "nominal", "sort": "-x", "title": null},
    "x": {
      "field": "boardings",
      "type": "quantitative",
      "title": "Est. match-day boardings",
      "axis": {"format": ","}
    },
    "color": {
      "field": "venue",
      "type": "nominal",
      "scale": {
        "domain": ["MCG", "MCG / AAMI Park", "Marvel Stadium", "All venues"],
        "range": ["#4caf50", "#4caf50", "#1565c0", "#9b59b6"]
      },
      "legend": {"title": "Primary Venue", "orient": "top"}
    },
    "tooltip": [
      {"field": "station"},
      {"field": "boardings", "title": "Match-day boardings", "format": ","},
      {"field": "venue", "title": "Venue served"}
    ]
  }
}
