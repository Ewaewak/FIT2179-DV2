{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of Richmond station estimated boardings by day of week and time period. Saturdays clearly show the match-day surge.",
  "width": "container",
  "height": 220,
  "data": {"url": "../data_heatmap.json", "format": {"type": "json"}},
  "mark": {"type": "rect"},
  "encoding": {
    "x": {
      "field": "period",
      "type": "ordinal",
      "sort": ["6am–9am", "9am–12pm", "12pm–3pm", "3pm–6pm", "6pm–9pm"],
      "title": "Time period"
    },
    "y": {
      "field": "day",
      "type": "ordinal",
      "sort": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "title": null
    },
    "color": {
      "field": "boardings",
      "type": "quantitative",
      "scale": {"scheme": "greens", "domain": [0, 20000]},
      "legend": {"title": "Boardings", "gradientLength": 100}
    },
    "tooltip": [
      {"field": "day"},
      {"field": "period", "title": "Time"},
      {"field": "boardings", "title": "Est. boardings", "format": ","}
    ]
  }
}
