{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Annual boardings at four key Melbourne precinct stations in 2024. Data source: Transport Victoria Annual Metropolitan Train Station Patronage (https://opendata.transport.vic.gov.au/dataset/annual-metropolitan-train-station-patronage-station-entries)",
  "width": "container",
  "height": 130,
  "data": {
    "url": "data_station_patronage.json"
  },
  "transform": [
    {
      "filter": "datum.year == 2024"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusTopRight": 3,
    "cornerRadiusBottomRight": 3
  },
  "encoding": {
    "y": {
      "field": "station",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "patronage",
      "type": "quantitative",
      "title": "Annual boardings",
      "axis": {
        "format": "~s"
      }
    },
    "color": {
      "value": "#f39c12"
    },
    "tooltip": [
      {
        "field": "station"
      },
      {
        "field": "patronage",
        "title": "Boardings 2024",
        "format": ","
      }
    ]
  }
}